<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#181818" android:gravity="center_vertical" android:padding="8dp" android:orientation="horizontal">
 <ImageView android:id="@+id/widget_image" android:layout_width="32dp" android:layout_height="32dp" android:scaleType="centerCrop"/>
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#8E949E" android:textSize="8sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_stat1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:textColor="#FFB000" android:textSize="14sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_stat2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_label1" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/widget_label2" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/widget_stat3" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/widget_stat4" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/widget_label3" android:layout_width="0dp" android:layout_height="0dp"/><TextView android:id="@+id/widget_label4" android:layout_width="0dp" android:layout_height="0dp"/>
</LinearLayout>