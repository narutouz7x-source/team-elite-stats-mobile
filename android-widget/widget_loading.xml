<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:background="#181818" android:padding="12dp">
 <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OG ELITE" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:text="SYNCING STATS…" android:textColor="#FFB000" android:textSize="11sp"/>
 <TextView android:id="@+id/widget_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:textColor="#FFFFFF" android:textSize="8sp"/>
</FrameLayout>