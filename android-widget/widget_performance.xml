<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerCrop"
        android:contentDescription="OG ELITE"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="17sp" android:textColor="#FFFFFF" android:maxLines="1"/>
        <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#BFC5D2" android:maxLines="1"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_label_rank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RANK" android:textSize="8sp" android:textColor="#8E96A7"/>
                <TextView android:id="@+id/widget_rank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textStyle="bold" android:textSize="18sp" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_label_points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="POINTS" android:textSize="8sp" android:textColor="#8E96A7"/>
                <TextView android:id="@+id/widget_points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textStyle="bold" android:textSize="18sp" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_label_kills" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TYPE" android:textSize="8sp" android:textColor="#8E96A7"/>
                <TextView android:id="@+id/widget_kills" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_label_matches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST" android:textSize="8sp" android:textColor="#8E96A7"/>
                <TextView android:id="@+id/widget_matches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
